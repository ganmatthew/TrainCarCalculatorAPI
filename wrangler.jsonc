{
  "name": "train-car-calculator-api",
  "main": "src/workers.ts",
  "compatibility_date": "2026-06-04",
  "assets": {
    "binding": "ASSETS",
    "directory": "./"
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}